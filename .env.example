# Copy to `.env` in this folder. Values are in Firebase Console → Project settings → Your apps.
# In Firebase Console, enable Email/Password: Authentication → Sign-in method.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — enables Firebase / Google Analytics (Console → Project settings → Your apps)
VITE_FIREBASE_MEASUREMENT_ID=
